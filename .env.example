# Copy to .env and fill in. Everything works WITHOUT any of these (offline extractor is the default).

# LLM extractor backend (optional). Provider is OpenRouter (OpenAI-compatible API).
# Any OpenAI-compatible endpoint works by overriding OPENROUTER_BASE_URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model id for the LLM extractor, e.g. z-ai/glm-5.3-flash (configurable at request time too)
VALIDATOR_LLM_MODEL=z-ai/glm-5.3-flash

# Extraction backend selection: offline (default, deterministic) | llm
VALIDATOR_EXTRACTION_BACKEND=offline

# HTTP behaviour
VALIDATOR_LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
