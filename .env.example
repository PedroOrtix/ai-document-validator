# Copy to .env and fill in. Everything works WITHOUT any of these: with no OPENROUTER_API_KEY
# the service uses the deterministic offline extractor as the default backend.

# LLM extractor backend (primary when a key is present). Provider is OpenRouter
# (OpenAI-compatible API). An examiner-only key is provided out-of-band with the submission:
# budget-capped at $1 USD and expiring one week after the submission date. Paste it below and
# restart the service; without it (or after it expires) the service automatically uses the
# offline extractor and degrades LLM failures to it at runtime.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model id for the LLM extractor, e.g. z-ai/glm-5.3-flash (configurable at request time too)
VALIDATOR_LLM_MODEL=z-ai/glm-5.3-flash

# Reasoning effort passed to the model (OpenRouter reasoning routing); empty disables it.
VALIDATOR_LLM_REASONING_EFFORT=low

# HTTP behaviour
VALIDATOR_LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
